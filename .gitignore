# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Opencode
!.opencode/
.opencode/*
!.opencode/themes/
!.opencode/tui.json

# Discovery documentation
docs/discovery/round-*-owner-response.md

# Handoff docs
docs/brainstorms/*-handoff.md

# Deepwork session state (git-local)
.slim/deepwork/

# Panthea monorepo (Bun workspaces + Tauri)
node_modules/
dist/
target/
apps/desktop/src-tauri/gen/
**/src-tauri/binaries/
**/src-tauri/permissions/autogenerated/
*.local

# backend-lifecycle probe run output (raw timestamped log; curated evidence
# lives in tools/probes/backend-lifecycle/README.md, not this file).
tools/probes/backend-lifecycle/lifecycle-results.txt
# Probe run outputs (raw JSON results, packet captures) — only probe source is checked in.
# Matches directory *contents*, not the directory itself, so a probe's own
# .gitignore can selectively un-ignore one committed file inside (e.g.
# tools/probes/inference-baseline/results/summary.json) — a directory-level
# match here would exclude the whole tree before any deeper negation is ever
# considered.
tools/probes/*/results/*
tools/probes/*/scratch/

# An unattended run's world store (with its WAL and SHM), its lock, and the archives exported from it stay local: they run to
# hundreds of megabytes. The report, run record, frames, proxy records, memory series and diagnostics beside them are evidence.
tools/scenarios/m2-greek-cast/unattended/*/app-data/
tools/scenarios/m2-greek-cast/unattended/**/*.sqlite*

# Studio authoring store (local requests, jobs, ledgers, blobs); canon lives in the registry
.studio/
.worktrees
