{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "panthea-desktop",
  "version": "0.1.0",
  "identifier": "ai.panthe.desktop",
  "build": {
    "beforeDevCommand": "bun run --cwd ../client dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --cwd ../client build && bash ../simulation/scripts/build-sidecar.sh",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Panthea",
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "form-action": "'none'",
        "base-uri": "'self'",
        "object-src": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/panthea-sim"],
    "resources": {
      "../../../content/greek/assets/registry/": "registry/",
      "../../../content/greek/assets/vocabulary.json": "vocabulary.json"
    }
  }
}
