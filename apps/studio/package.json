    "test": "bun test",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@panthea/assets": "workspace:*",
    "@tauri-apps/api": "2.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.185.1",
    "three-flatland": "0.1.0-alpha.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "7.3.7"
  }
}
