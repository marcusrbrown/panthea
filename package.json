{
  "name": "panthea",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*",
    "tools/probes/*"
  ],
  "scripts": {
    "dev": "bun --bun run --cwd apps/desktop tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:client": "bun run --cwd apps/client dev",
    "dev:sim": "bun run --cwd apps/simulation dev",
    "build": "bun run --cwd apps/client build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "bun test --parallel=4",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
